<Window x:Class="StreamRecorder.Desktop.Views.AppDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="460"
        MaxWidth="560"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="{DynamicResource ElevatedSurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                Padding="18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border x:Name="IconBadge"
                        Width="34"
                        Height="34"
                        CornerRadius="17"
                        VerticalAlignment="Top"
                        Background="{DynamicResource DialogInfoBackgroundBrush}">
                    <TextBlock x:Name="IconTextBlock"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="18"
                               FontWeight="Bold"
                               Text="i"
                               Foreground="{DynamicResource DialogInfoForegroundBrush}" />
                </Border>

                <ScrollViewer Grid.Column="1"
                              Margin="14,0,0,0"
                              MaxHeight="240"
                              VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="MessageTextBlock"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontSize="14"
                               LineHeight="22"
                               TextWrapping="Wrap" />
                </ScrollViewer>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1"
                    Margin="0,16,0,0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button x:Name="ConfirmButton"
                    Width="100"
                    Click="ConfirmButton_Click"
                    Content="确定"
                    IsDefault="True" />
            <Button x:Name="CancelButton"
                    Width="100"
                    Click="CancelButton_Click"
                    Content="取消"
                    IsCancel="True"
                    Visibility="Collapsed" />
        </StackPanel>
    </Grid>
</Window>
