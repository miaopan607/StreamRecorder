<Window x:Class="StreamRecorder.Desktop.Views.JobEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="任务编辑"
        Width="760"
        Height="760"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#F6F0E3">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="新增或编辑任务"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="#204451" />
            <TextBlock Margin="0,6,0,0"
                       Text="单条模式用于添加一个直播间。批量模式每行一条，支持：画质编号,链接,主播名。"
                       TextWrapping="Wrap"
                       Foreground="#4D5D60" />
        </StackPanel>

        <TabControl Grid.Row="1"
                    Margin="0,18,0,18"
                    x:Name="ModeTabs"
                    Background="#FFFDF7"
                    BorderBrush="#D8C7B2">
            <TabItem Header="单条添加">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,8,12,8" VerticalAlignment="Center" Text="直播间链接" />
                        <TextBox x:Name="UrlTextBox" Grid.Row="0" Grid.Column="1" Margin="0,8,0,8" MinWidth="420" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,8,12,8" VerticalAlignment="Center" Text="主播名称" />
                        <TextBox x:Name="StreamerNameTextBox" Grid.Row="1" Grid.Column="1" Margin="0,8,0,8" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,8,12,8" VerticalAlignment="Center" Text="录制画质" />
                        <ComboBox x:Name="QualityComboBox" Grid.Row="2" Grid.Column="1" Margin="0,8,0,8">
                            <ComboBoxItem Content="OD" />
                            <ComboBoxItem Content="UHD" />
                            <ComboBoxItem Content="HD" />
                            <ComboBoxItem Content="SD" />
                            <ComboBoxItem Content="LD" />
                        </ComboBox>

                        <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,8,12,8" VerticalAlignment="Center" Text="录制格式" />
                        <ComboBox x:Name="FormatComboBox" Grid.Row="3" Grid.Column="1" Margin="0,8,0,8">
                            <ComboBoxItem Content="TS" />
                            <ComboBoxItem Content="FLV" />
                            <ComboBoxItem Content="MKV" />
                            <ComboBoxItem Content="MOV" />
                            <ComboBoxItem Content="MP4" />
                            <ComboBoxItem Content="MP3" />
                            <ComboBoxItem Content="M4A" />
                        </ComboBox>

                        <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,8,12,8" VerticalAlignment="Center" Text="保存目录" />
                        <TextBox x:Name="RecordingDirTextBox" Grid.Row="4" Grid.Column="1" Margin="0,8,0,8" />

                        <TextBlock Grid.Row="5"
                                   Grid.Column="1"
                                   Margin="0,0,0,8"
                                   Foreground="#5E6C6F"
                                   Text="留空时按默认保存路径自动分平台和主播"
                                   TextWrapping="Wrap" />

                        <TextBlock Grid.Row="6" Grid.Column="0" Margin="0,8,12,8" VerticalAlignment="Center" Text="分段时长（秒）" />
                        <TextBox x:Name="SegmentTimeTextBox" Grid.Row="6" Grid.Column="1" Margin="0,8,0,8" />

                        <TextBlock Grid.Row="7" Grid.Column="0" Margin="0,8,12,8" VerticalAlignment="Center" Text="定时开始时间" />
                        <TextBox x:Name="ScheduledStartTextBox" Grid.Row="7" Grid.Column="1" Margin="0,8,0,8" />

                        <TextBlock Grid.Row="8" Grid.Column="0" Margin="0,8,12,8" VerticalAlignment="Center" Text="监控小时数" />
                        <TextBox x:Name="MonitorHoursTextBox" Grid.Row="8" Grid.Column="1" Margin="0,8,0,8" />

                        <TextBlock Grid.Row="9" Grid.Column="0" Margin="0,8,12,8" VerticalAlignment="Top" Text="开关项" />
                        <WrapPanel Grid.Row="9" Grid.Column="1" Margin="0,8,0,8">
                            <CheckBox x:Name="MonitorCheckBox" Margin="0,0,18,8" Content="立即开始监控" IsChecked="True" />
                            <CheckBox x:Name="SegmentCheckBox" Margin="0,0,18,8" Content="启用分段录制" />
                            <CheckBox x:Name="ScheduledCheckBox" Margin="0,0,18,8" Content="启用定时录制" />
                            <CheckBox x:Name="MessagePushCheckBox" Margin="0,0,18,8" Content="启用消息推送" IsChecked="True" />
                            <CheckBox x:Name="OnlyNotifyCheckBox" Margin="0,0,18,8" Content="仅通知不录制" />
                            <CheckBox x:Name="DirectDownloadCheckBox" Margin="0,0,18,8" Content="使用 FLV 直连下载" />
                        </WrapPanel>

                        <Border Grid.Row="10"
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                Margin="0,16,0,0"
                                Padding="14"
                                CornerRadius="10"
                                Background="#FFF8EE"
                                BorderBrush="#E2CDAE"
                                BorderThickness="1">
                            <TextBlock TextWrapping="Wrap"
                                       Foreground="#6A593F"
                                       Text="当前版本已经支持任务持久化、直播状态检测和自动拉起 FFmpeg 录制。" />
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="批量导入" x:Name="BatchTab">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock TextWrapping="Wrap"
                               Foreground="#4D5D60"
                                Text="每行一条。示例：&#10;0,https://live.douyin.com/123456,主播1&#10;2,https://www.twitch.tv/demo,主播2&#10;https://live.bilibili.com/320" />
                    <TextBox x:Name="BatchTextBox"
                             Grid.Row="1"
                             Margin="0,14,0,0"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             TextWrapping="Wrap"
                             FontFamily="Consolas"
                             MinHeight="430" />
                </Grid>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Width="110" Margin="0,0,10,0" Click="CancelButton_Click" Content="取消" />
            <Button Width="140" Background="#204451" Foreground="White" Click="SaveButton_Click" Content="保存任务" />
        </StackPanel>
    </Grid>
</Window>
